# Copy this file to .env and fill in your values.
# .env is git-ignored — never commit real keys.

# ── OpenCode upstream ──────────────────────────────────────────────────────
# Your OpenCode API key (required)
OPENCODE_API_KEY=sk-...

# OpenCode free-tier endpoint (required if using free-tier models)
OPENCODE_FREE_URL=https://opencode.ai/zen/v1

# Additional keys for free-auto key-pool rotation
# OPENCODE_API_KEY_2=sk-...
# OPENCODE_API_KEY_3=sk-...
# OPENCODE_API_KEY_4=sk-...

# ── Ollama upstream ────────────────────────────────────────────────────────
# Ollama target endpoint (defaults to https://ollama.com for Cloud access)
# OLLAMA_URL=https://ollama.com
# Your Ollama Cloud API key
# OLLAMA_API_KEY=your_key_here
# Additional Ollama keys for rotation
# OLLAMA_API_KEY_2=your_key_2
# OLLAMA_API_KEY_3=your_key_3
# OLLAMA_API_KEY_4=your_key_4

# ── Proxy server ───────────────────────────────────────────────────────────
PORT=8080

# ── Ingress auth (optional) ────────────────────────────────────────────────
# If set, every inbound request must carry "Authorization: Bearer <value>"
# PROXY_API_KEY=change-me-to-any-secret
